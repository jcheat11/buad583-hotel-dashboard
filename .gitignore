local_data/

# Safety net: ignore every spreadsheet except the fictional samples.
*.xlsx
*.xlsm
*.xls
*.csv
!sample_data/*.xlsx
!sample_data/*.csv

# Python clutter
__pycache__/
*.pyc
.venv/
.streamlit/secrets.toml

# Portable test builds (made by packaging/build_portable.py)
dist/
